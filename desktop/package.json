{
  "name": "selena-port",
  "productName": "Selena-port",
  "version": "0.1.0",
  "description": "Desktop console for a local Punishing: Gray Raven server",
  "main": "main.js",
  "author": "Caya8205",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "npm run prepare-runtime && electron-builder --win nsis portable",
    "dev": "electron . --dev",
    "prepare-runtime": "node prepare-runtime.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.selena.port",
    "productName": "Selena-port",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**",
      "web-ui/**"
    ],
    "extraResources": [
      {
        "from": "../Resources/table",
        "to": "table"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../web-ui/icon.webp"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
