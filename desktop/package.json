{
  "name": "selena-port",
  "productName": "Selena-port",
  "version": "26.11.17",
  "description": "Desktop console for a local Punishing: Gray Raven server",
  "main": "main.js",
  "author": "Caya8205",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dev": "electron . --dev"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.selena.port",
    "productName": "Selena-port",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.js",
      "ui/**"
    ],
    "extraResources": [
      {
        "from": "../web-ui",
        "to": "web-ui"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "lit": "^3.3.3"
  }
}
